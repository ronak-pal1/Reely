# REELIO environment. Copy to .env at the repo root and to apps/web/.env.local for Next public vars.
# Never commit real secrets.

# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info
WORKER_CONCURRENCY=2

# Data
MONGODB_URI=mongodb://127.0.0.1:27017/reelio
REDIS_URL=redis://127.0.0.1:6379

# Auth. Generate long random strings before any shared deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace-with-a-long-random-string
CSRF_SECRET=replace-with-a-long-random-string

# Google OAuth. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Transactional email. In development, verification links are logged when SMTP is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=REELIO <noreply@example.com>

# Object storage. local writes to DATA_DIR/uploads. s3 uses the credentials below (R2, MinIO, or AWS).
STORAGE_DRIVER=local
DATA_DIR=data
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=reelio
S3_ACCESS_KEY_ID=reelio
S3_SECRET_ACCESS_KEY=reelio-local-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=524288000

# AI. Requests fail closed when a key is missing. There is no fake model output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Lemon Squeezy. Checkout and webhooks stay disabled until these are set.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_STUDIO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_STUDIO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_CREDIT_PACK_VARIANT_ID=

# Remotion. Local export uses @remotion/renderer. Lambda is used only when the function settings exist.
REMOTION_SERVE_URL=
REMOTION_FUNCTION_NAME=
REMOTION_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring. Both are optional.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_API_URL=http://localhost:4000
